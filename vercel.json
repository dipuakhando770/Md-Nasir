{
  "version": 2,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/meta-conversions",
      "destination": "/api/meta-conversions"
    },
    {
      "source": "/api/payment/create",
      "destination": "/api/payment/create"
    },
    {
      "source": "/api/payment/callback",
      "destination": "/api/payment/callback"
    },
    {
      "source": "/api/payment/verify",
      "destination": "/api/payment/verify"
    },
    {
      "source": "/modules/gateways/callback/jonotapay.php",
      "destination": "/api/payment/callback"
    },
    {
      "source": "/modules/gateways/callback/paybd.php",
      "destination": "/api/payment/callback"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|sitemap\\.xml|robots\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
